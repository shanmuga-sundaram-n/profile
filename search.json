---
layout: none
---
[
  {% assign pages_and_posts = site.pages | concat: site.posts %}
  {% for item in pages_and_posts %}
    {% unless item.url contains '/assets' or item.url contains '/feed' or item.url contains '/sitemap' or item.url contains '/robots' or item.url == '/404.html' or item.url contains '/search' or item.url contains '/CLAUDE' or item.url contains '/LOCAL_DEVELOPMENT' %}
    {
      "title": {{ item.title | default: item.name | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "description": {{ item.description | default: "" | jsonify }},
      "excerpt": {{ item.excerpt | default: "" | strip_html | strip_newlines | truncate: 300 | jsonify }},
      "content": {{ item.content | strip_html | strip_newlines | normalize_whitespace | truncate: 5000 | jsonify }},
      "type": {% if item.date %}"post"{% else %}"page"{% endif %},
      "date": {{ item.date | date: "%B %d, %Y" | default: "" | jsonify }},
      "tags": {{ item.tags | default: "" | jsonify }},
      "categories": {{ item.categories | default: "" | jsonify }}
    },
    {% endunless %}
  {% endfor %}
  {% for project in site.data.projects %}
    {
      "title": {{ project.title | jsonify }},
      "url": {{ "/projects/" | relative_url | jsonify }},
      "description": {{ project.description | default: "" | jsonify }},
      "excerpt": {{ project.description | default: "" | truncate: 200 | jsonify }},
      "content": {{ project.technologies | join: ", " | jsonify }},
      "type": "project",
      "date": "",
      "tags": {{ project.technologies | default: "" | jsonify }},
      "categories": ["project"]
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
